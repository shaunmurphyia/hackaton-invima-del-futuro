# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Supabase Configuration
# (If left blank, the backend automatically uses the InMemory Resilient Repository so demo never breaks)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# AI & Agent Configuration (Future/Optional Extensions)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Upload Configuration
MAX_FILE_SIZE_MB=25
